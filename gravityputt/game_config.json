{
  "_comment": "Gravity Putt (H5 offline) operational parameters. Single source of truth: build_h5_gravity.py inlines this object into window.gameConfig, so no business value is hardcoded in the game code.",
  "meta": {
    "gameId": "gravityputt",
    "title": { "zh": "星洞高尔夫", "en": "Gravity Putt" },
    "subtitle": { "zh": "一杆，一星系", "en": "One shot. One galaxy." }
  },
  "viewport": {
    "designWidth": 402,
    "designHeight": 619,
    "guardTopPct": 0.05,
    "guardBottomPct": 0.05,
    "cornerClearPx": 26,
    "minTapSizePx": 40,
    "_maxPixelRatio": "render at the screen's native density so vector edges and text stay crisp; the adaptive block only kicks in if a device cannot hold the frame budget.",
    "maxPixelRatio": 3,
    "_adaptiveQuality": "sampleFrames = ring buffer size; minFrames = frames before judging; slowFrameMs = median budget (22ms ~ 45fps); steps = successive caps to fall back to.",
    "adaptiveQuality": {
      "enabled": true,
      "sampleFrames": 60,
      "minFrames": 90,
      "checkEvery": 30,
      "slowFrameMs": 22,
      "steps": [2, 1.5]
    }
  },
  "locale": {
    "supported": ["zh", "en"],
    "fallback": "en",
    "_followSystem": "false = always start in English and let the player switch; true = sniff the device locale. English remains the fallback either way.",
    "followSystem": false
  },
  "course": {
    "_comment": "The play field is inset from the safe content box; levels store normalised coordinates (0..1) so a notch or a different aspect never pushes geometry outside the safe area.",
    "hudHeight": 44,
    "hintHeight": 26,
    "levelInsetTop": 6,
    "levelInsetBottom": 6
  },
  "physics": {
    "_comment": "All motion is integrated from these numbers only; the simulation is deterministic so the rules can be unit-tested and replayed. G and masses are the per-body config of the course itself.",
    "gravityG": 3200,
    "softening": 60,
    "subStepHz": 120,
    "dragPerSec": 0.7,
    "maxSpeed": 900,
    "launchSpeedMax": 900,
    "launchDragMaxPx": 180,
    "launchFineGain": 0.35,
    "launchMinPower": 0.08,
    "ballRadius": 7,
    "stopSpeed": 40,
    "maxFlightSec": 8,
    "holeRadius": 20,
    "holeCaptureSpeed": 260,
    "holeDeflectDeg": 12,
    "planetRestitution": 0.55,
    "outOfBoundsPx": 14,
    "aimBufferPx": 26
  },
  "bodies": {
    "_comment": "mass ranges are per-type defaults a level may override; BH=black hole horizon, well=influence radius factor for the predictor cutoff",
    "rock": { "m": 1500, "r": 24 },
    "ice": { "m": 1000, "r": 22 },
    "giant": { "m": 2600, "r": 32 },
    "blackhole": { "horizon": 16, "well": 90 },
    "repulsor": { "m": 1800, "r": 26 },
    "wormhole": { "r": 18 },
    "predictorCutoffPx": 70,
    "orbitSpeedRadPerSec": 1.05
  },
  "predictor": {
    "_comment": "the dotted launch preview uses the SAME simulate() as live play, cut short near any body so the rest of the flight stays a puzzle",
    "maxSec": 2.2,
    "dotSpacingPx": 26,
    "fadeTail": 4
  },
  "scoring": {
    "_comment": "stars: strokes <= par -> 3, par+1 -> 2, within maxStrokes -> 1",
    "starPar": 3,
    "starParPlusOne": 2,
    "holeBonus": 100
  },
  "unlocks": {
    "_comment": "chapter gates measured in total stars collected",
    "chapter2Stars": 6,
    "chapter3Stars": 15
  },
  "audio": {
    "enabled": true,
    "masterVolume": 0.4
  },
  "anim": {
    "briefSec": 1.25,
    "settleDelaySec": 0.55,
    "resultDelaySec": 0.75,
    "trailMax": 14,
    "particleCap": 220,
    "aimBlocksInputSec": 0.35,
    "shakeBlackholeSec": 0.2
  },
  "storage": {
    "prefix": "gravityputt_",
    "keys": { "lang": "lang", "stats": "stats", "agreed": "agreed" },
    "maxValueBytes": 262144
  },
  "theme": {
